; Engine configuration file.
; 사람이 직접 고쳐도 되지만, 에디터에서 저장하면 형식이 정리될 수 있다.

config_version=5

[application]

config/name="BOBUSANG"
config/description="지게에 짐을 쌓아 고개를 넘는 조선 보부상 물리 로그라이크"
run/main_scene="res://game/leg_scene.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameInput="*res://input/game_input.gd"
Tuning="*res://debug/tuning.gd"
Loc="*res://ui/loc.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")


[internationalization]

locale/fallback="ko"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=12.0
3d/sleep_threshold_linear=0.08
3d/sleep_threshold_angular=0.1
3d/time_before_sleep=0.4

[rendering]

anti_aliasing/quality/msaa_3d=2

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="porter"
3d_physics/layer_3="items"
3d_physics/layer_4="debris"
